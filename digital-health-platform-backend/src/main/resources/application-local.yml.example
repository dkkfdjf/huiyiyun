# 复制本文件为 application-local.yml(已 .gitignore),填入真实值即可。
# 由 application.yml 的 spring.config.import 自动加载(优先级高于 application.yml,不存在则忽略)。
# 部署环境不建此文件,改用环境变量 MYSQL_PASSWORD / HUIYI_JWT_SECRET(见 application.yml 默认占位)。
spring:
  datasource:
    url: jdbc:mysql://localhost:3306/huiyiyun?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&useSSL=false
    username: root
    password: <your-mysql-password>
huiyi:
  jwt:
    secret: <a-long-random-secret-at-least-32-chars>
                                                                                        